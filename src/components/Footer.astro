---
import { CONTACT } from '../config';

// NOTE: both of these are placeholders until Aoife & Mark confirm the real
// address and number — see src/config.ts.
const mailto = `mailto:${CONTACT.email}`;
const whatsapp = `https://wa.me/${CONTACT.whatsapp}`;
---

<footer class="band footer">
  <!--
    The wildflowers are drawn as CSS backgrounds rather than <img> tags.
    They are purely decorative, and this way the browser only downloads the
    artwork for the layout it is actually showing: two corner clusters on
    desktop, or the single full-width border on a phone. An <img> that is
    display:none would still be fetched.
  -->
  <div class="container layer-up footer__inner">
    <h2 class="heading footer__heading">We hope you can join us!</h2>

    <hr class="rule" />

    <div class="prose footer__text">
      <p>
        We'll be sharing all the details on how to RSVP a little closer to the time. For now, please
        save the date – we can't wait to celebrate with you!
      </p>
      <p>If you have any questions in the meantime, please don't hesitate to get in touch.</p>
    </div>

    <p class="footer__actions">
      <a class="btn btn--outline" href={mailto}>Email</a>
      <a class="btn btn--outline" href={whatsapp} target="_blank" rel="noopener noreferrer">
        WhatsApp
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-green-band);
    /* The extra bottom padding is what gives the corner flowers room to
       sit below the buttons rather than behind them. */
    padding-block: var(--section-y) clamp(4.5rem, 7.5vw, 7rem);
    text-align: center;
  }

  .footer__inner {
    /* This element is also the .container, so it carries the gutter padding.
       The gutter has to be added on top of the text width, otherwise the
       padding eats into it and the paragraphs wrap early. */
    max-width: calc(29rem + var(--gutter) * 2);
  }

  .footer__heading {
    font-size: var(--fs-section);
  }

  .footer__text {
    margin-inline: auto;
  }

  .footer__actions {
    margin-top: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
  }

  /* Corner clusters, anchored to the bottom edge they grow from.
     Sized by width; the aspect ratio keeps their height in proportion. */
  .footer::before,
  .footer::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: clamp(9rem, 20vw, 17.5rem);
    aspect-ratio: 560 / 687;
    background-repeat: no-repeat;
    background-position: bottom center;
    background-size: contain;
    pointer-events: none;
    z-index: 0;
  }

  .footer::before {
    left: 0;
    background-image: url('/images/accent-meadow-2.webp');
  }

  .footer::after {
    right: 0;
    background-image: url('/images/accent-meadow-1.webp');
  }

  @media (max-width: 640px) {
    /* Room for the full-width flower border beneath the buttons. */
    .footer {
      padding-bottom: 10rem;
    }

    /* Break the heading after "CAN", as the mobile design does, rather
       than letting "US!" fall onto a line of its own. */
    .footer__heading {
      max-width: 17rem;
      margin-inline: auto;
    }

    /* One continuous border across the foot of the band, in place of the
       two corner clusters. */
    .footer::before {
      left: 0;
      right: 0;
      width: 100%;
      aspect-ratio: 1100 / 610;
      background-image: url('/images/footer-flowers.webp');
      background-size: cover;
      background-position: bottom center;
    }

    .footer::after {
      display: none;
    }

    /* Full-width, stacked contact buttons. */
    .footer__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .footer__actions .btn {
      display: block;
      width: 100%;
    }
  }
</style>
