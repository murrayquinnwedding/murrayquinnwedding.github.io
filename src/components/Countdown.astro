---
import { WEDDING_DATE, WEDDING_DATE_ISO } from '../config';

/**
 * Split the gap between two dates into days/hours/minutes/seconds.
 * Clamped at zero so the day itself (and anything after) shows 0s
 * rather than negative numbers.
 */
function parts(target: Date, from: Date) {
  const ms = Math.max(0, target.getTime() - from.getTime());
  const total = Math.floor(ms / 1000);
  return {
    days: Math.floor(total / 86400),
    hours: Math.floor((total % 86400) / 3600),
    mins: Math.floor((total % 3600) / 60),
    secs: total % 60,
  };
}

// Rendered at BUILD time. This is what visitors see for the fraction of a
// second before the client script starts — and what they keep seeing if
// JavaScript is unavailable. It is slightly stale rather than blank or NaN.
const initial = parts(WEDDING_DATE, new Date());

const units = [
  { key: 'days', label: 'Days', value: initial.days },
  { key: 'hours', label: 'Hours', value: initial.hours },
  { key: 'mins', label: 'Mins', value: initial.mins },
  { key: 'secs', label: 'Seconds', value: initial.secs },
] as const;
---

<section class="countdown" aria-label="Countdown to the wedding">
  <div class="container">
    <ul class="countdown__list" data-countdown data-target={WEDDING_DATE_ISO}>
      {
        units.map((unit) => (
          <li class="countdown__item">
            <span class="countdown__value" data-unit={unit.key}>
              {unit.value}
            </span>
            <span class="countdown__label">{unit.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-countdown]');

  if (root) {
    const target = new Date(root.dataset.target ?? '').getTime();

    // If the date is unparseable for any reason, leave the server-rendered
    // numbers in place rather than replacing them with NaN.
    if (!Number.isNaN(target)) {
      const fields = {
        days: root.querySelector<HTMLElement>('[data-unit="days"]'),
        hours: root.querySelector<HTMLElement>('[data-unit="hours"]'),
        mins: root.querySelector<HTMLElement>('[data-unit="mins"]'),
        secs: root.querySelector<HTMLElement>('[data-unit="secs"]'),
      };

      const set = (el: HTMLElement | null, n: number) => {
        const next = String(n);
        // Only touch the DOM when the value actually changed.
        if (el && el.textContent !== next) el.textContent = next;
      };

      const tick = () => {
        const ms = Math.max(0, target - Date.now());
        const total = Math.floor(ms / 1000);
        set(fields.days, Math.floor(total / 86400));
        set(fields.hours, Math.floor((total % 86400) / 3600));
        set(fields.mins, Math.floor((total % 3600) / 60));
        set(fields.secs, total % 60);
        return total;
      };

      tick();
      const id = window.setInterval(() => {
        if (tick() <= 0) window.clearInterval(id);
      }, 1000);
    }
  }
</script>

<style>
  .countdown {
    background: var(--c-cream);
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
  }

  .countdown__list {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .countdown__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-1);
    min-width: 3.5rem; /* stops the row shuffling as digits change width */
  }

  .countdown__value {
    font-family: var(--font-body);
    font-size: var(--fs-count);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--c-gold);
    /* Tabular figures keep each digit the same width, so the numbers do not
       jitter sideways as the seconds tick over. */
    font-variant-numeric: lining-nums tabular-nums;
  }

  .countdown__label {
    font-size: var(--fs-small);
    letter-spacing: var(--ls-eyebrow);
    text-indent: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c-ink);
  }

  @media (max-width: 640px) {
    .countdown__list {
      gap: 0;
      justify-content: space-between;
    }
    .countdown__item {
      flex: 1;
      min-width: 0;
    }
  }
</style>
