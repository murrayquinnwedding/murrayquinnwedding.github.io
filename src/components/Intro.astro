---
// The polaroid frame, rotation, washi tape and drop shadow are all baked
// into these PNGs from the Figma file, so they need no CSS treatment —
// they just get placed.

// A 1x1 transparent GIF. On phones this stands in for Mark's photo, whose
// figure is hidden there because the combined image already shows him.
// It is inline, so it costs no request. A hidden <img> would still be
// downloaded — `display: none` and `loading="lazy"` do NOT prevent that,
// which is why the swap is done with <picture> and `media` instead.
const BLANK =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<section class="intro">
  <div class="container intro__grid">
    <figure class="intro__photo intro__photo--left">
      <picture>
        <!-- On a phone this slot carries the pair of photos as one image,
             laid out and overlapped in the Figma file. -->
        <source media="(max-width: 860px)" srcset="/images/intro-pair.webp" />
        <img
          src="/images/aoife.webp"
          alt="Aoife and Mark as children, both smiling"
          width="900"
          height="953"
          loading="lazy"
        />
      </picture>
    </figure>

    <div class="intro__text">
      <h2 class="heading intro__heading">
        We are so excited to celebrate our wedding with our favourite people!
      </h2>

      <hr class="rule" />

      <div class="prose">
        <p>
          With our wedding falling on Easter Monday, we'd love for you to join us in making a little
          celebration of the long weekend.
        </p>
        <p>
          We've created this website to share all the details you'll need as we count down to the
          big day. We'll be adding more information as plans come together, so do check back for
          updates.
        </p>
        <p>We can't wait to celebrate with you!</p>
      </div>

      <p class="intro__signoff">
        Le Grá,<br />
        <strong>Aoife &amp; Mark</strong>
      </p>
    </div>

    <figure class="intro__photo intro__photo--right">
      <picture>
        <!-- Hidden on phones, where the combined image already shows Mark,
             so the real photo is not downloaded there. -->
        <source media="(max-width: 860px)" srcset={BLANK} />
        <img
          src="/images/mark.webp"
          alt="Mark as a young boy, smiling"
          width="900"
          height="1059"
          loading="lazy"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .intro {
    background: var(--c-white);
    padding-block: var(--section-y);
  }

  /* Desktop: photo | text | photo.
     The text column is capped so the paragraphs stay a comfortable
     reading width however wide the screen gets. */
  .intro__grid {
    display: grid;
    grid-template-columns: 1fr minmax(0, 32rem) 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
  }

  .intro__text {
    text-align: center;
  }

  .intro__heading {
    font-size: var(--fs-intro);
    letter-spacing: var(--ls-intro);
    text-indent: var(--ls-intro);
    line-height: 1.35;
    /* Narrower than the paragraphs beneath it, which is what gives the
       heading its three-line shape in the design. */
    max-width: 28rem;
    margin-inline: auto;
  }

  /* The paragraphs sit on a slightly narrower measure than the column. */
  .intro__text .prose,
  .intro__signoff {
    max-width: 29rem;
    margin-inline: auto;
  }

  .intro__signoff {
    margin-top: var(--s-3);
    line-height: 1.6;
  }

  .intro__photo {
    margin: 0;
  }

  .intro__photo img {
    width: 100%;
    height: auto;
  }

  /* Nudge the two photos vertically so they sit slightly offset from one
     another, as in the design, rather than in a dead-straight row. */
  .intro__photo--left {
    justify-self: start;
    max-width: 19rem;
    transform: translateY(-0.5rem);
  }

  .intro__photo--right {
    justify-self: end;
    max-width: 18rem;
    transform: translateY(1.5rem);
  }


  /* --- Mobile -----------------------------------------------------------
     Text first, then the pair of photos beneath it as a single image.
     --------------------------------------------------------------------- */
  @media (max-width: 860px) {
    .intro__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* The photos sit either side of the text in the markup, so the rows
       have to be set explicitly — otherwise auto-placement strands the
       photo above the text. */
    .intro__text {
      grid-row: 1;
      margin-bottom: var(--s-6);
    }

    /* This slot now holds the combined image (see the <picture> above). */
    .intro__photo--left {
      grid-row: 2;
      justify-self: center;
      max-width: none;
      transform: none;
      width: min(100%, 24rem);
    }

    .intro__photo--right {
      display: none;
    }
  }
</style>
